{
  "name": "plexus",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "macOS HUD that shows coding agents walking a repo in real time",
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "plexus": "./bin/plexus.ts"
  },
  "scripts": {
    "start": "node bin/plexus.ts",
    "hud": "node bin/plexus.ts",
    "build:hud": "swift build -c release --package-path macos && node bin/package-hud.ts",
    "quit": "node bin/plexus.ts quit",
    "test": "node --test tests/extract.test.ts tests/sessions.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}

